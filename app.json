{
  "expo": {
    "name": "מאמן הכושר שלי",
    "slug": "ai-fitness-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "supportsRTL": true,
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-secure-store",
      "expo-localization",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "האפליקציה משתמשת במיקרופון לצורך אינטראקציה קולית במהלך האימון",
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "האפליקציה זקוקה למצלמה כדי לנתח את תנועות האימון בזמן אמת",
        "NSMicrophoneUsageDescription": "האפליקציה משתמשת במיקרופון לצורך אינטראקציה קולית במהלך האימון"
      }
    },
    "android": {
      "supportsRTL": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.aifitnesscoach"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
